{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/login", "destination": "/server.js" },
    { "source": "/signup", "destination": "/server.js" },
    { "source": "/forgot-password", "destination": "/server.js" },
    { "source": "/app", "destination": "/server.js" },
    { "source": "/", "destination": "/server.js" }
  ],
  "functions": {
    "server.js": {
      "includeFiles": [
        "css/**",
        "js/**",
        "data/**",
        "audio/**",
        "*.html"
      ]
    }
  }
}
